# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key
SUPABASE_ANON_KEY=sb_publishable_your_anon_key

# Backend Service Role Key (Admin operations - NEVER commit to git or expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Backend Server Configuration
PORT=5050

# Comma-separated list of browser origins allowed to call the API with
# credentials (native mobile clients aren't affected by this).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Stripe secret key (backend only - NEVER commit to git or put in the app)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Set to true to make mobile bookings require a completed payment. Leave it
# off until a test-card booking has been checked end to end with it on.
REQUIRE_PAYMENT_PROOF=false
